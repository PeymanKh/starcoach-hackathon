# Docker
IMAGE=ghcr.io/peymankh/starcoach-hackathon:latest
DOMAIN=change-me

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=change-me
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain-or-sslip-host

# DB
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://app:change-me@db:5432/app

# Redis
REDIS_URL=redis://redis:6379/0